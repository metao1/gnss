/* Route the application UART bridge to the nRF9151 SMA DK header pins.
 * Wire P0.29/TX to the 4WD board Bluetooth RX net, and P0.28/RX to Bluetooth TX.
 */

/ {
	aliases {
		gnss-uart = &uart1;
	};
};

&pinctrl {
	uart1_4wd_default: uart1_4wd_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 29)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 28)>;
			bias-pull-up;
		};
	};

	uart1_4wd_sleep: uart1_4wd_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 29)>,
				<NRF_PSEL(UART_RX, 0, 28)>;
			low-power-enable;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_4wd_default>;
	pinctrl-1 = <&uart1_4wd_sleep>;
	pinctrl-names = "default", "sleep";
};
